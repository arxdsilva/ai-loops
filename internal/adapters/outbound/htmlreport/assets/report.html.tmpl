<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>loops report · {{.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<header>
<h1>{{.Title}}</h1>
<div class="meta">
<span>run {{.ID}}</span>
{{if .Ticket}}<span>ticket {{if .TicketURL}}<a href="{{.TicketURL}}">{{.Ticket}}</a>{{else}}{{.Ticket}}{{end}}</span>{{end}}
{{if .Source}}<span>source {{.Source}}</span>{{end}}
<span>outcome <span class="badge {{.OutcomeClass}}">{{.Outcome}}</span></span>
{{if .PR}}<span>PR {{if .PRURL}}<a href="{{.PRURL}}">{{.PR}}</a>{{else}}{{.PR}}{{end}}</span>{{end}}
{{if .Duration}}<span>duration {{.Duration}}</span>{{end}}
</div>
<div class="counts">
<div><b>{{.S.Steps}}</b>steps</div>
<div><b class="{{if .S.Errors}}bad{{end}}">{{.S.Errors}}</b>errors</div>
<div><b>{{len .S.Lanes}}</b>lanes</div>
<div><b>{{.S.PlanRounds}}</b>plan rounds</div>
<div><b>{{len .S.LoopBacks}}</b>loop-backs</div>
<div><b class="{{if .S.Denials}}bad{{end}}">{{.S.Denials}}</b>denials</div>
<div><b>{{.S.MemoryQ}}/{{.S.MemoryW}}</b>mem q/w</div>
</div>
</header>

<section id="phases">
<h2>Phases</h2>
<div class="phases">
{{range .Phases}}<div class="phase {{.Class}}"><b>{{.Index}} {{.Title}}</b>{{if .Time}}<span>{{.Time}}</span>{{else}}<span class="mut">–</span>{{end}}{{if .Reentries}}<br><span class="badge">{{.Reentries}}× re-entered</span>{{end}}</div>
{{end}}
</div>
</section>

<section id="lanes">
<h2>Lanes</h2>
{{if .Lanes}}
<div class="gantt">
{{range .Lanes}}<div class="lane">
<div class="name"><b>{{.Name}}</b><br><span class="mut">{{.Role}}{{if .Model}} · {{.Model}}{{end}}{{if .Wave}} · W{{.Wave}}{{end}} · {{.Steps}} steps</span>{{if .QA}} <span class="badge {{.QAClass}}">QA {{.QA}}{{if .QARounds}} r{{.QARounds}}{{end}}</span>{{end}}</div>
<div class="track" title="{{.Span}}"><div class="bar {{.Class}}" style="left:{{.Left}}%;width:{{.Width}}%"><span>{{.Span}}</span></div></div>
</div>
{{end}}
</div>
{{else}}<p class="empty">No lanes recorded.</p>{{end}}
<h3>Loop-backs</h3>
{{if .S.LoopBacks}}<ul>
{{range .S.LoopBacks}}<li>↺ {{.From}} → {{.To}}{{if .Round}} (round {{.Round}}){{end}}{{if .Phase}} <span class="mut">[{{.Phase}}]</span>{{end}}{{if .Reason}}: {{.Reason}}{{end}}</li>
{{end}}</ul>{{else}}<p class="empty">None.</p>{{end}}
</section>

<section id="verdicts">
<h2>Verdicts</h2>
<p>Plan rounds: <b>{{.S.PlanRounds}}</b></p>
{{if .S.Verdicts}}<div class="tablewrap"><table>
<thead><tr><th>Name</th><th>Status</th><th>Round</th><th>By</th><th>Phase</th><th>Ref</th></tr></thead>
<tbody>
{{range .S.Verdicts}}<tr><td class="wrap">{{.Name}}</td><td class="n"><span class="badge {{statusClass .Status}}">{{.Status}}</span></td><td>{{if .Round}}{{.Round}}{{end}}</td><td>{{if .Role}}{{.Role}}{{else}}{{.Agent}}{{end}}</td><td>{{.Phase}}</td><td class="wrap">{{.Ref}}</td></tr>
{{end}}</tbody></table></div>{{else}}<p class="empty">No verdicts.</p>{{end}}
<h3>Acceptance criteria → proof</h3>
{{if .ACs}}<div class="tablewrap"><table>
<thead><tr><th>AC</th><th>Verdict</th><th>Proof</th></tr></thead>
<tbody>
{{range .ACs}}<tr><td class="wrap">{{.Name}}</td><td class="n">{{if .Status}}<span class="badge {{statusClass .Status}}">{{.Status}}</span>{{else}}<span class="mut">–</span>{{end}}</td><td class="wrap">{{range .Proofs}}{{if .URL}}<a href="{{.URL}}">{{.Ref}}</a>{{else}}{{.Ref}}{{end}}{{if .Note}} <span class="mut">{{.Note}}</span>{{end}}<br>{{else}}<span class="mut">–</span>{{end}}</td></tr>
{{end}}</tbody></table></div>{{else}}<p class="empty">No acceptance criteria recorded.</p>{{end}}
</section>

<section id="gates">
<h2>Gates</h2>
{{if .S.Gates}}<div class="tablewrap"><table>
<thead><tr><th>Gate</th><th>Latest</th><th>ms</th><th>Note</th></tr></thead>
<tbody>
{{range .S.Gates}}<tr><td>{{.Name}}</td><td>{{if .OK}}<span class="ok">✓ pass</span>{{else}}<span class="bad">✗ fail</span>{{end}}</td><td>{{.DurationMS}}</td><td class="wrap">{{.Note}}</td></tr>
{{end}}</tbody></table></div>
{{else}}<p class="empty">No gates run.</p>{{end}}
{{if .GateHistory}}<details><summary>History ({{len .GateHistory}})</summary><div class="tablewrap"><table>
<thead><tr><th>Time</th><th>Gate</th><th>Result</th><th>ms</th><th>Note</th></tr></thead>
<tbody>
{{range .GateHistory}}<tr><td class="n">{{.Time}}</td><td>{{.Name}}</td><td>{{if .OK}}<span class="ok">✓</span>{{else}}<span class="bad">✗</span>{{end}}</td><td>{{.MS}}</td><td class="wrap">{{.Note}}</td></tr>
{{end}}</tbody></table></div></details>{{end}}
</section>

<section id="steplog">
<h2>Step log</h2>
{{if .Steps}}
<details><summary>{{len .Steps}} steps{{if .StepsTrunc}} (showing first {{.StepCap}}){{end}}</summary>
<div class="controls"><label>Lane <select id="lane-filter"><option value="">all</option>{{range .LaneOpts}}<option value="{{.}}">{{.}}</option>{{end}}</select></label></div>
<div class="tablewrap"><table id="steps">
<thead><tr><th>Time</th><th>Lane</th><th>Tool</th><th>Target</th><th>OK</th><th>ms</th></tr></thead>
<tbody>
{{range .Steps}}<tr data-lane="{{.Lane}}"><td class="n">{{.Time}}</td><td>{{.Lane}}</td><td>{{.Tool}}</td><td class="wrap">{{.Target}}</td><td>{{if .OK}}<span class="ok">✓</span>{{else}}<span class="bad">✗</span>{{end}}</td><td>{{.MS}}</td></tr>
{{end}}</tbody></table></div></details>
{{else}}<p class="empty">No steps recorded.</p>{{end}}
</section>

<section id="guards">
<h2>Guard denials</h2>
{{if .Denials}}<div class="tablewrap"><table>
<thead><tr><th>Time</th><th>Guard</th><th>Lane</th><th>Reason</th></tr></thead>
<tbody>
{{range .Denials}}<tr><td class="n">{{.Time}}</td><td>{{.Name}}</td><td>{{.Lane}}</td><td class="wrap">{{.Note}}</td></tr>
{{end}}</tbody></table></div>{{else}}<p class="empty">None.</p>{{end}}
<h2>Memory</h2>
{{if .Memory}}<div class="tablewrap"><table>
<thead><tr><th>Time</th><th>Op</th><th>Target</th><th>Note</th></tr></thead>
<tbody>
{{range .Memory}}<tr><td class="n">{{.Time}}</td><td>{{.Name}}</td><td class="wrap">{{.Target}}</td><td class="wrap">{{.Note}}</td></tr>
{{end}}</tbody></table></div>{{else}}<p class="empty">No memory operations.</p>{{end}}
</section>

{{if .Docs}}<section id="docs">
<h2>Documents</h2>
{{range .Docs}}<details><summary>{{.Title}} <span class="mut">{{.File}}</span></summary><pre>{{.Text}}</pre></details>
{{end}}</section>{{end}}

<script>{{.JS}}</script>
</body>
</html>
