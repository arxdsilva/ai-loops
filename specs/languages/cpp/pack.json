{
 "schema": 1,
 "id": "cpp",
 "name": "C++ (backend)",
 "versions": {
  "stable": "C++23 (C++26 technically complete, ISO publication pending); GCC 16.2, Clang 23.1, CMake 4.4",
  "as_of": "2026-11"
 },
 "detect": [
  {
   "file": "CMakeLists.txt"
  },
  {
   "file": "CMakePresets.json"
  }
 ],
 "variants": [
  {
   "name": "clang",
   "detect": [
    {
     "file": "CMakePresets.json",
     "contains": "fprofile-instr-generate"
    }
   ],
   "coverage": {
    "format": "lcov",
    "path": "{coverage}",
    "produced_by": [
     "test-tsan"
    ],
    "produce": [
     {
      "argv": [
       "sh",
       "-c",
       "d=$1; mkdir -p \"$d\" && llvm-profdata merge -sparse build/tsan/profraw/*.profraw -o \"$d/cov.profdata\" && set -- $(find build/tsan -type f -perm -u+x -name '*_test') && b=$1 && shift && n=$# && i=0 && while [ $i -lt $n ]; do set -- \"$@\" -object \"$1\"; shift; i=$((i+1)); done && exec llvm-cov export -format=lcov -instr-profile=\"$d/cov.profdata\" \"$b\" \"$@\"",
       "sh",
       "{coverage_dir}"
      ],
      "stdout_to": "{coverage}"
     }
    ],
    "granularity": "line",
    "exclude": [
     "build/**",
     "third_party/**",
     "external/**",
     "vcpkg_installed/**",
     "src/app/**",
     "**/main.cpp",
     "**/main.cc"
    ]
   }
  }
 ],
 "scope": {
  "pkgs": [],
  "pkg_dirs": [
   "."
  ]
 },
 "source_globs": [
  "**/*.cpp",
  "**/*.cc",
  "**/*.cxx",
  "**/*.hpp",
  "**/*.hh",
  "**/*.h",
  "**/*.ipp",
  "**/*.tpp"
 ],
 "test_globs": [
  "**/*_test.cpp",
  "**/*_test.cc",
  "**/test_*.cpp",
  "tests/**",
  "test/**"
 ],
 "generated": {
  "globs": [
   "**/*.pb.cc",
   "**/*.pb.h",
   "**/*.grpc.pb.cc",
   "**/*.grpc.pb.h",
   "**/*_generated.h",
   "build/**",
   "vcpkg_installed/**"
  ],
  "header_regex": "^// Generated by the protocol buffer compiler\\.  DO NOT EDIT!$"
 },
 "manifest": "CMakeLists.txt",
 "checks": [
  {
   "name": "configure",
   "kind": "build",
   "argv": [
    "cmake",
    "--preset",
    "dev"
   ],
   "required": true,
   "tool": "cmake",
   "note": "vcpkg manifest mode installs the pinned baseline here; Conan projects run `conan install` first (lang-cpp repo.md)"
  },
  {
   "name": "build",
   "kind": "build",
   "argv": [
    "cmake",
    "--build",
    "--preset",
    "dev"
   ],
   "required": true,
   "tool": "cmake"
  },
  {
   "name": "clang-format",
   "kind": "format",
   "argv": [
    "sh",
    "-c",
    "git ls-files -z -- '*.cpp' '*.cc' '*.cxx' '*.hpp' '*.hh' '*.h' | xargs -0 -r clang-format --dry-run -Werror"
   ],
   "required": true,
   "tool": "clang-format",
   "when_file": [
    ".clang-format",
    "_clang-format"
   ],
   "install": "pipx install clang-format"
  },
  {
   "name": "clang-tidy",
   "kind": "lint",
   "argv": [
    "run-clang-tidy",
    "-p",
    "build/dev",
    "-quiet"
   ],
   "required": false,
   "tool": "run-clang-tidy",
   "when_file": [
    ".clang-tidy"
   ],
   "install": "install the clang-tools package of your LLVM version",
   "note": "needs CMAKE_EXPORT_COMPILE_COMMANDS=ON in the dev preset"
  },
  {
   "name": "cppcheck",
   "kind": "sast",
   "argv": [
    "cppcheck",
    "--project=build/dev/compile_commands.json",
    "--error-exitcode=1",
    "--enable=warning,performance,portability"
   ],
   "required": false,
   "tool": "cppcheck",
   "default": "off",
   "install": "install cppcheck from your package manager"
  },
  {
   "name": "arch",
   "kind": "arch",
   "internal": "arch",
   "required": false
  },
  {
   "name": "test-tsan",
   "kind": "test",
   "argv": [
    "sh",
    "-c",
    "cmake --preset tsan && cmake --build --preset tsan && ctest --preset tsan --output-on-failure --no-tests=error"
   ],
   "required": true,
   "tool": "ctest",
   "env": {
    "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1"
   },
   "signal_regex": "ThreadSanitizer|AddressSanitizer|LeakSanitizer|runtime error:|\\*\\*\\*Failed|\\*\\*\\*Timeout|tests failed|error:|warning:",
   "note": "TSan merged with coverage (GCC --coverage, or Clang -fprofile-instr-generate -fcoverage-mapping) in the tsan preset"
  },
  {
   "name": "test-asan-ubsan",
   "kind": "test",
   "argv": [
    "sh",
    "-c",
    "cmake --preset asan-ubsan && cmake --build --preset asan-ubsan && ctest --preset asan-ubsan --output-on-failure --no-tests=error"
   ],
   "required": true,
   "tool": "ctest",
   "signal_regex": "ThreadSanitizer|AddressSanitizer|LeakSanitizer|runtime error:|\\*\\*\\*Failed|\\*\\*\\*Timeout|tests failed|error:|warning:",
   "note": "TSan cannot share a build with ASan, so this is a separate required build"
  },
  {
   "name": "coverage",
   "kind": "coverage",
   "internal": "coverage",
   "required": true,
   "skippable": false
  },
  {
   "name": "osv-scanner",
   "kind": "vuln",
   "argv": [
    "osv-scanner",
    "scan",
    "source",
    "--lockfile",
    "conan.lock"
   ],
   "required": false,
   "tool": "osv-scanner",
   "when_file": [
    "conan.lock"
   ],
   "default": "off",
   "install": "go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest",
   "note": "OSV reads conan.lock only, not vcpkg.json, and its Conan advisory coverage is thin"
  }
 ],
 "test_commands": [
  {
   "argv_prefix": [
    "ctest"
   ]
  },
  {
   "argv_prefix": [
    "cmake",
    "--workflow"
   ]
  },
  {
   "argv_prefix": [
    "bazel",
    "test"
   ]
  },
  {
   "argv_prefix": [
    "meson",
    "test"
   ]
  }
 ],
 "race": {
  "mode": "build",
  "flags": [
   "-fsanitize=thread",
   "-fno-omit-frame-pointer",
   "-g",
   "-O1"
  ],
  "env": {
   "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1"
  },
  "checks": [
   "test-tsan"
  ],
  "reason": "ThreadSanitizer needs its own instrumented build tree and cannot be combined with ASan or LSan; it runs merged with coverage"
 },
 "coverage": {
  "format": "lcov",
  "path": "{coverage}",
  "produced_by": [
   "test-tsan"
  ],
  "produce": [
   {
    "argv": [
     "gcovr",
     "--root",
     ".",
     "--object-directory",
     "build/tsan",
     "--lcov",
     "{coverage}",
     "--filter",
     "src/"
    ]
   }
  ],
  "granularity": "line",
  "exclude": [
   "build/**",
   "third_party/**",
   "external/**",
   "vcpkg_installed/**",
   "src/app/**",
   "**/main.cpp",
   "**/main.cc"
  ]
 },
 "post_edit": {
  "format_file": [
   "clang-format",
   "-i",
   "{file}"
  ],
  "lint_dir": null
 },
 "cache_env": {
  "CCACHE_TEMPDIR": "tmp"
 },
 "shared_env": [
  "CCACHE_DIR",
  "VCPKG_DEFAULT_BINARY_CACHE",
  "VCPKG_DOWNLOADS",
  "CONAN_HOME"
 ],
 "env_hints": {
  "CMAKE_BUILD_PARALLEL_LEVEL": "2",
  "CTEST_PARALLEL_LEVEL": "2"
 },
 "artifacts": [
  "build/",
  "cmake-build-*/",
  "CMakeFiles/",
  "CMakeCache.txt",
  "compile_commands.json",
  "Testing/",
  "vcpkg_installed/",
  "*.gcda",
  "*.gcno",
  "*.gcov",
  "*.profraw",
  "*.profdata",
  "*.lcov",
  "core",
  "core.[0-9]*"
 ],
 "arch": {
  "parser": "regex",
  "import_regex": "^\\s*#\\s*include\\s*[<\"]([^>\"]+)[>\"]",
  "resolver": "include-path",
  "forbidden_in_domain": [
   "fstream",
   "filesystem",
   "thread",
   "mutex",
   "future",
   "iostream",
   "sys/socket.h",
   "unistd.h",
   "boost/asio",
   "boost/beast",
   "grpcpp",
   "pqxx",
   "drogon",
   "curl/curl.h"
  ],
  "impure_calls": [
   "std::chrono::system_clock::now",
   "std::chrono::steady_clock::now",
   "std::random_device",
   "std::rand(",
   "getenv(",
   "std::cout",
   "std::cerr",
   "std::thread",
   "std::async"
  ]
 },
 "test_jobs": "CMAKE_BUILD_PARALLEL_LEVEL=2 CTEST_PARALLEL_LEVEL=2",
 "config_files": [
  ".clang-format",
  ".clang-tidy",
  ".clangd",
  "CMakePresets.json",
  "vcpkg.json",
  "vcpkg-configuration.json",
  "conanfile.txt",
  "conanfile.py",
  "conan.lock",
  ".editorconfig"
 ],
 "sources": {
  "checks": "https://cmake.org/cmake/help/latest/manual/cmake-presets.7.html",
  "format": "https://clang.llvm.org/docs/ClangFormat.html",
  "lint": "https://clang.llvm.org/extra/clang-tidy/",
  "test": "https://cmake.org/cmake/help/latest/manual/ctest.1.html",
  "race": "https://clang.llvm.org/docs/ThreadSanitizer.html",
  "sanitizers": "https://gcc.gnu.org/onlinedocs/gcc/Instrumentation-Options.html",
  "coverage": "https://gcovr.com/en/stable/output/lcov.html",
  "coverage_llvm": "https://llvm.org/docs/CommandGuide/llvm-cov.html",
  "sast": "https://cppcheck.sourceforge.io/manual.html",
  "vuln": "https://google.github.io/osv-scanner/",
  "cache": "https://ccache.dev/manual/latest.html"
 },
 "notes": [
  "Presets dev, tsan and asan-ubsan are project-defined (lang-cpp repo.md); read the real names from the project's CMakePresets.json and override the argv in .loops/config.json when they differ.",
  "The tsan preset carries coverage instrumentation (D3); asan-ubsan stays separate.",
  "Bazel and Meson projects are not auto-detected: their test commands are recognised by the guard, but the checks assume CMake presets."
 ]
}