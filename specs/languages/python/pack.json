{
  "schema": 1,
  "id": "python",
  "name": "Python",
  "versions": {
    "stable": "3.15",
    "as_of": "2026-11"
  },
  "detect": [
    {
      "file": "pyproject.toml"
    },
    {
      "file": "uv.lock"
    },
    {
      "file": "requirements.txt"
    }
  ],
  "variants": [
    {
      "name": "ruff-toml",
      "detect": [
        {
          "file": "ruff.toml"
        }
      ],
      "checks": [
        {
          "name": "ruff-format",
          "required": true
        }
      ]
    },
    {
      "name": "dot-ruff-toml",
      "detect": [
        {
          "file": ".ruff.toml"
        }
      ],
      "checks": [
        {
          "name": "ruff-format",
          "required": true
        }
      ]
    },
    {
      "name": "ruff-pyproject",
      "detect": [
        {
          "file": "pyproject.toml",
          "contains": "[tool.ruff"
        }
      ],
      "checks": [
        {
          "name": "ruff-format",
          "required": true
        }
      ]
    }
  ],
  "scope": {
    "pkgs": [
      "src"
    ],
    "pkg_dirs": [
      "."
    ]
  },
  "source_globs": [
    "**/*.py",
    "**/*.pyi"
  ],
  "test_globs": [
    "**/test_*.py",
    "**/*_test.py",
    "**/conftest.py",
    "tests/**"
  ],
  "generated": {
    "globs": [
      "**/*_pb2.py",
      "**/*_pb2_grpc.py",
      "**/*_pb2.pyi",
      "**/migrations/versions/*.py"
    ],
    "header_regex": "^# (?:Generated by the protocol buffer compiler|Code generated|This file was automatically generated).*$"
  },
  "manifest": "pyproject.toml",
  "checks": [
    {
      "name": "sync",
      "kind": "deps",
      "argv": [
        "uv",
        "sync",
        "--locked"
      ],
      "required": false,
      "tool": "uv",
      "when_file": [
        "uv.lock"
      ],
      "install": "pip install uv",
      "fallback_argv": [
        "python",
        "-m",
        "pip",
        "install",
        "-e",
        ".",
        "--group",
        "dev"
      ]
    },
    {
      "name": "ruff-format",
      "kind": "format",
      "argv": [
        "ruff",
        "format",
        "--check",
        "{pkg_dirs}"
      ],
      "required": false,
      "tool": "ruff",
      "install": "uv tool install ruff"
    },
    {
      "name": "ruff",
      "kind": "lint",
      "argv": [
        "ruff",
        "check",
        "--output-format=concise",
        "{pkg_dirs}"
      ],
      "required": true,
      "tool": "ruff",
      "install": "uv tool install ruff"
    },
    {
      "name": "mypy",
      "kind": "typecheck",
      "argv": [
        "mypy",
        "--strict",
        "{pkgs}"
      ],
      "required": false,
      "tool": "mypy",
      "when_file": [
        "mypy.ini",
        ".mypy.ini",
        "setup.cfg",
        "pyproject.toml"
      ],
      "install": "uv add --group lint mypy",
      "note": "type checker is picked by project config: mypy here, pyright below; each skips when its tool is not installed"
    },
    {
      "name": "pyright",
      "kind": "typecheck",
      "argv": [
        "pyright"
      ],
      "required": false,
      "tool": "pyright",
      "when_file": [
        "pyrightconfig.json",
        "pyproject.toml"
      ],
      "install": "uv add --group lint pyright"
    },
    {
      "name": "import-linter",
      "kind": "arch",
      "argv": [
        "lint-imports"
      ],
      "required": false,
      "tool": "import-linter",
      "when_file": [
        ".importlinter"
      ],
      "install": "uv add --group lint import-linter"
    },
    {
      "name": "test",
      "kind": "test",
      "required": true,
      "tool": "pytest",
      "argv": [
        "pytest",
        "-p",
        "randomly",
        "-n",
        "2",
        "-W",
        "error",
        "{coverage_args}"
      ],
      "coverage_args": [
        "--cov",
        "--cov-branch",
        "--cov-report=xml:{coverage}"
      ],
      "env": {
        "PYTHONDEVMODE": "1"
      },
      "install": "uv add --group test pytest pytest-cov pytest-randomly pytest-xdist",
      "signal_regex": "^(FAILED|ERROR) |^E  |Traceback|ResourceWarning"
    },
    {
      "name": "coverage",
      "kind": "coverage",
      "internal": "coverage",
      "required": true,
      "skippable": false
    },
    {
      "name": "bandit",
      "kind": "sast",
      "argv": [
        "bandit",
        "-r",
        "{pkgs}",
        "-ll",
        "-q"
      ],
      "required": false,
      "tool": "bandit",
      "install": "uv add --group lint bandit"
    },
    {
      "name": "pip-audit",
      "kind": "vuln",
      "argv": [
        "pip-audit",
        "--locked",
        "."
      ],
      "required": false,
      "tool": "pip-audit",
      "default": "off",
      "install": "uv tool install pip-audit"
    }
  ],
  "security": {"checks": ["bandit", "pip-audit"]},
  "test_commands": [
    {
      "argv_prefix": [
        "pytest"
      ]
    },
    {
      "argv_prefix": [
        "python",
        "-m",
        "pytest"
      ]
    },
    {
      "argv_prefix": [
        "python3",
        "-m",
        "pytest"
      ]
    },
    {
      "argv_prefix": [
        "uv",
        "run",
        "pytest"
      ]
    },
    {
      "argv_prefix": [
        "coverage",
        "run"
      ]
    }
  ],
  "race": {
    "mode": "none",
    "checks": [
      "test"
    ],
    "reason": "CPython has no flag-enabled data-race detector. TSan needs a separate interpreter build (--disable-gil --with-thread-sanitizer); pytest-run-parallel finds races only on free-threaded builds; pytest-randomly and pytest-xdist expose order and shared-state bugs but do not detect races.",
    "substitute": "pytest -p randomly -n 2 -W error under PYTHONDEVMODE=1 (random order, two workers, warnings as errors, asyncio debug, ResourceWarning on). When the project uses threads on a free-threaded interpreter, also run PYTHON_GIL=0 pytest --parallel-threads=4 --iterations=10."
  },
  "coverage": {
    "format": "cobertura",
    "path": "{coverage}",
    "produced_by": [
      "test"
    ],
    "granularity": "branch",
    "exclude": [
      "tests/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/conftest.py",
      "**/*.pyi",
      "**/migrations/**",
      "**/compose.py",
      "**/main.py",
      "**/__main__.py"
    ]
  },
  "post_edit": {
    "format_file": [
      "ruff",
      "format",
      "{file}"
    ],
    "lint_dir": [
      "ruff",
      "check",
      "{dir}"
    ]
  },
  "cache_env": {
    "PYTHONPYCACHEPREFIX": "tmp",
    "MYPY_CACHE_DIR": "cache",
    "RUFF_CACHE_DIR": "cache",
    "COVERAGE_FILE": "{tmp}/.coverage"
  },
  "shared_env": [
    "UV_CACHE_DIR",
    "PIP_CACHE_DIR"
  ],
  "artifacts": [
    "__pycache__/",
    "*.py[cod]",
    ".pytest_cache/",
    ".mypy_cache/",
    ".ruff_cache/",
    ".hypothesis/",
    ".coverage",
    ".coverage.*",
    "coverage.xml",
    "coverage.lcov",
    "htmlcov/",
    ".benchmarks/",
    "*.egg-info/",
    "**/__pycache__/",
    "**/*.egg-info/",
    ".metrics/",
    "target/coverage/"
  ],
  "arch": {
    "parser": "none",
    "native_check": "import-linter",
    "forbidden_in_domain": [
      "os",
      "requests",
      "httpx",
      "sqlalchemy",
      "django",
      "fastapi",
      "flask",
      "boto3",
      "pydantic",
      "subprocess",
      "socket"
    ],
    "impure_calls": [
      "datetime.now",
      "datetime.utcnow",
      "time.time",
      "random.",
      "uuid.uuid4",
      "os.environ",
      "threading.Thread",
      "asyncio.create_task"
    ]
  },
  "test_jobs": "-n 2",
  "config_files": [
    "pyproject.toml",
    "ruff.toml",
    ".ruff.toml",
    "mypy.ini",
    ".mypy.ini",
    "pyrightconfig.json",
    "setup.cfg",
    "pytest.ini",
    "tox.ini",
    ".coveragerc",
    ".importlinter",
    "uv.toml",
    ".editorconfig",
    ".pre-commit-config.yaml",
    ".python-version"
  ],
  "sources": {
    "checks": "https://docs.astral.sh/ruff/configuration/ ; https://docs.astral.sh/uv/concepts/projects/sync/ ; https://mypy.readthedocs.io/en/stable/command_line.html ; https://microsoft.github.io/pyright/#/command-line ; https://import-linter.readthedocs.io/en/stable/ ; https://bandit.readthedocs.io/en/latest/man/bandit.html ; https://github.com/pypa/pip-audit ; https://pip.pypa.io/en/stable/cli/pip_install/",
    "race": "https://py-free-threading.github.io/testing/ ; https://py-free-threading.github.io/thread_sanitizer/ ; https://github.com/Quansight-Labs/pytest-run-parallel ; https://github.com/pytest-dev/pytest-randomly ; https://docs.python.org/3/library/devmode.html",
    "coverage": "https://pytest-cov.readthedocs.io/en/latest/config.html ; https://coverage.readthedocs.io/en/latest/commands/cmd_xml.html",
    "cache": "https://docs.astral.sh/uv/concepts/cache/ ; https://docs.python.org/3/using/cmdline.html#envvar-PYTHONPYCACHEPREFIX"
  }
}
