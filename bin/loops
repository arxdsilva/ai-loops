#!/bin/sh
# loops shim. Resolution order:
#   1. in a git checkout (developers): build cmd/loops from source (unless LOOPS_PREFER_RELEASE=1)
#   2. a non-script `loops` on PATH reporting this plugin's version
#   3. the cached binary for this version
#   4. download the release binary (checksum verified) into the cache
#   5. build from source with Go, if available
# On the Bash PATH while the plugin is enabled; hooks call it via ${CLAUDE_PLUGIN_ROOT}/bin/loops.
set -e
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
export LOOPS_PLUGIN_ROOT="$root"
V=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" 2>/dev/null | head -n 1)
cache="${CLAUDE_PLUGIN_DATA:-${PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/loops}}"
loops_base='https://github.com/arxdsilva/ai-loops/releases/download'
# --- shared begin (identical in bin/loops and the generated shim; a test keeps them in sync)
# loops_path: sets bin to a non-script loops on PATH that reports "loops $V".
loops_path() {
  oldifs=$IFS
  IFS=:
  for d in $PATH; do
    c="${d:-.}/loops"
    if [ -f "$c" ] && [ -x "$c" ] && [ "$(dd if="$c" bs=2 count=1 2>/dev/null)" != '#!' ]; then
      if [ "$("$c" version 2>/dev/null || true)" = "loops $V" ]; then
        IFS=$oldifs
        bin=$c
        return 0
      fi
    fi
  done
  IFS=$oldifs
  return 1
}
# loops_cached: sets bin to the cached binary for $V.
loops_cached() {
  for c in "$cache/loops-$V" "$cache/loops-$V.exe"; do
    if [ -x "$c" ]; then
      bin=$c
      return 0
    fi
  done
  return 1
}
# loops_platform: sets os, arch, ext; fails when no prebuilt binary exists.
loops_platform() {
  ext=
  os=$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m 2>/dev/null)
  case $os in
    darwin | linux) ;;
    mingw* | msys* | cygwin*) os=windows ext=.exe ;;
    *) return 1 ;;
  esac
  case $arch in
    x86_64 | amd64 | AMD64) arch=amd64 ;;
    arm64 | aarch64 | ARM64) arch=arm64 ;;
    *) return 1 ;;
  esac
}
loops_fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 2 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    return 1
  fi
}
loops_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}
# loops_download: fetches, verifies and caches the release binary; sets bin.
# Returns 1 when unavailable (no release, offline, no sha256 tool) so the
# caller can fall back; exits 1 when the checksum is missing or wrong.
loops_download() {
  loops_platform || return 1
  if [ "${LOOPS_SKIP_VERIFY:-}" != 1 ] && ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
    echo "loops: neither sha256sum nor shasum found; refusing an unverified download (set LOOPS_SKIP_VERIFY=1 to override)" >&2
    return 1
  fi
  asset="loops-$os-$arch$ext"
  url="${LOOPS_RELEASE_BASE:-$loops_base}/v$V"
  mkdir -p "$cache" || return 1
  tmp="$cache/.dl-$$"
  rm -rf "$tmp"
  mkdir -p "$tmp" || return 1
  if ! loops_fetch "$url/$asset" "$tmp/$asset"; then
    rm -rf "$tmp"
    return 1
  fi
  if [ "${LOOPS_SKIP_VERIFY:-}" != 1 ]; then
    if ! loops_fetch "$url/checksums.txt" "$tmp/checksums.txt"; then
      rm -rf "$tmp"
      echo "loops: could not fetch checksums.txt for v$V; refusing an unverified binary" >&2
      exit 1
    fi
    want=$(awk -v n="$asset" '$2 == n || $2 == "*" n {print $1; exit}' "$tmp/checksums.txt")
    got=$(loops_sha256 "$tmp/$asset")
    if [ -z "$want" ] || [ "$want" != "$got" ]; then
      rm -rf "$tmp"
      echo "loops: checksum mismatch for $asset v$V; refusing to run it" >&2
      exit 1
    fi
  fi
  chmod +x "$tmp/$asset"
  mv -f "$tmp/$asset" "$cache/loops-$V$ext"
  rm -rf "$tmp"
  bin="$cache/loops-$V$ext"
  loops_prune
}
# loops_prune keeps only the newest 3 cached binaries.
loops_prune() {
  ls -1t "$cache"/loops-* 2>/dev/null | tail -n +4 | xargs rm -f 2>/dev/null || true
}
# --- shared end

# loops_build: dev mode, builds cmd/loops from the checkout into the cache.
loops_build() {
  [ -d "$root/cmd/loops" ] && command -v go >/dev/null 2>&1 || return 1
  # Source fingerprint: newest mtime + file count of the Go sources (cheap, no hashing tool needed).
  stamp=$(find "$root/cmd" "$root/internal" "$root/go.mod" -type f \( -name '*.go' -o -name 'go.mod' -o -name '*.tmpl' -o -name '*.css' -o -name '*.js' \) 2>/dev/null |
    xargs ls -l 2>/dev/null | awk '{print $5,$6,$7,$8,$9}' | cksum | awk '{print $1}')
  bin="$cache/loops-src-$stamp"
  if [ ! -x "$bin" ]; then
    mkdir -p "$cache"
    (cd "$root" && CGO_ENABLED=0 go build -trimpath -o "$bin.tmp" ./cmd/loops) >&2 || return 1
    mv -f "$bin.tmp" "$bin" || return 1
    loops_prune
  fi
}

if [ -e "$root/.git" ] && [ "${LOOPS_PREFER_RELEASE:-}" != 1 ] && loops_build; then
  exec "$bin" "$@"
fi
if [ -n "$V" ]; then
  if loops_path || loops_cached; then
    exec "$bin" "$@"
  fi
  if loops_download; then
    exec "$bin" "$@"
  fi
fi
if loops_build; then
  exec "$bin" "$@"
fi
echo "loops: no prebuilt binary for ${os:-$(uname -s)}/${arch:-$(uname -m)} v${V:-unknown} and no Go toolchain; see https://github.com/arxdsilva/ai-loops/blob/main/docs/GUIDE.md#install" >&2
exit 1
