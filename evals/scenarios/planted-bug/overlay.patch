+package pricing
+
+import "testing"
+
+func TestBulkDiscount_TenPercentFromTenItems(t *testing.T) {
+	if got := BulkDiscountCents(Line{SKU: "a", Qty: 25, UnitCents: 120}); got != 300 {
+		t.Fatalf("BulkDiscountCents = %d, want 300", got)
+	}
+}
+
+func TestBulkDiscount_NoneBelowTen(t *testing.T) {
+	if got := BulkDiscountCents(Line{SKU: "a", Qty: 3, UnitCents: 120}); got != 0 {
+		t.Fatalf("BulkDiscountCents = %d, want 0", got)
+	}
+}
