+package pricing
+
+// BulkMinQty is the quantity from which a line gets the bulk discount.
+const BulkMinQty = 10
+
+// BulkDiscountCents returns the bulk discount of a line: 10% of its total,
+// rounded down, when it has BulkMinQty items or more; otherwise 0.
+func BulkDiscountCents(l Line) int64 {
+	if l.Qty > BulkMinQty {
+		return int64(l.Qty) * l.UnitCents / 10
+	}
+	return 0
+}
