#!/bin/sh
# loops package shim (generated by loops port build - do not edit;
# specs/PLATFORMS.md §6). Runs the loops binary that matches this package:
# loops on PATH when its version matches, else a cached build, else
# 'go install github.com/arxdsilva/ai-loops/cmd/loops@v0.3.0' into the cache.
set -e
# Resolve symlinks to this script (relative targets are relative to the
# link's directory) so the package root is found from any link on PATH.
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
export LOOPS_PLUGIN_ROOT="$root"
want='loops 0.3.0'
module='github.com/arxdsilva/ai-loops'
tag='v0.3.0'

# 1. loops on PATH with the matching version (scripts such as this shim are skipped).
oldifs=$IFS
IFS=:
for d in $PATH; do
  c="${d:-.}/loops"
  if [ -f "$c" ] && [ -x "$c" ] && [ "$(dd if="$c" bs=2 count=1 2>/dev/null)" != '#!' ]; then
    if [ "$("$c" version 2>/dev/null || true)" = "$want" ]; then
      IFS=$oldifs
      exec "$c" "$@"
    fi
  fi
done
IFS=$oldifs

# 2. the cached build, 3. installed with go install on first use.
cache="${LOOPS_BIN_CACHE:-${PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/loops}}"
bin="$cache/loops-0.3.0"
if [ ! -x "$bin" ]; then
  if ! command -v go >/dev/null 2>&1; then
    echo "loops: $want is not on PATH and the Go toolchain is missing; install Go (https://go.dev/dl) or put loops 0.3.0 on PATH (go install $module/cmd/loops@$tag)" >&2
    exit 1
  fi
  mkdir -p "$cache"
  tmp="$cache/.install-$$"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  if ! GOBIN="$tmp" CGO_ENABLED=0 go install "$module/cmd/loops@$tag" >&2; then
    rm -rf "$tmp"
    echo "loops: go install $module/cmd/loops@$tag failed (the module must be reachable: public, or GOPRIVATE set)" >&2
    exit 1
  fi
  mv -f "$tmp/loops" "$bin"
  rm -rf "$tmp"
fi
exec "$bin" "$@"
