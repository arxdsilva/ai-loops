{
  "schema": 1,
  "id": "kotlin",
  "name": "Kotlin (JVM backend)",
  "versions": {
    "stable": "2.4.21",
    "as_of": "2026-11"
  },
  "detect": [
    {
      "file": "src/main/kotlin"
    },
    {
      "file": "build.gradle.kts",
      "contains": "kotlin("
    },
    {
      "file": "build.gradle.kts",
      "contains": "org.jetbrains.kotlin"
    },
    {
      "file": "gradle/libs.versions.toml",
      "contains": "org.jetbrains.kotlin"
    }
  ],
  "source_globs": [
    "**/src/main/**/*.kt",
    "**/src/main/**/*.kts"
  ],
  "test_globs": [
    "**/src/test/**/*.kt",
    "**/src/integrationTest/**/*.kt",
    "**/*Test.kt",
    "**/*Tests.kt",
    "**/*IT.kt",
    "**/*Spec.kt"
  ],
  "generated": {
    "globs": [
      "**/build/generated/**",
      "**/generated/**/*.kt",
      "**/*Generated.kt"
    ],
    "header_regex": "^// Generated by .*|^// This file was generated|^// Code generated .*"
  },
  "checks": [
    {
      "name": "build",
      "kind": "build",
      "argv": [
        "./gradlew",
        "--console=plain",
        "assemble"
      ],
      "required": true,
      "tool": "gradle"
    },
    {
      "name": "ktlint",
      "kind": "format",
      "argv": [
        "./gradlew",
        "--console=plain",
        "ktlintCheck"
      ],
      "required": false,
      "tool": "ktlint-gradle",
      "install": "plugins { id(\"org.jlleitschuh.gradle.ktlint\") version \"14.2.0\" }",
      "skip_on": {
        "output_regex": "Task 'ktlintCheck' not found",
        "note": "ktlint Gradle plugin not applied: add plugins { id(\"org.jlleitschuh.gradle.ktlint\") version \"14.2.0\" }"
      }
    },
    {
      "name": "detekt",
      "kind": "lint",
      "argv": [
        "./gradlew",
        "--console=plain",
        "detekt"
      ],
      "required": false,
      "tool": "detekt",
      "install": "plugins { id(\"io.gitlab.arturbosch.detekt\") version \"1.23.8\" }",
      "skip_on": {
        "output_regex": "Task 'detekt' not found",
        "note": "detekt Gradle plugin not applied: add plugins { id(\"io.gitlab.arturbosch.detekt\") version \"1.23.8\" }"
      }
    },
    {
      "name": "arch",
      "kind": "arch",
      "internal": "arch",
      "required": false
    },
    {
      "name": "test",
      "kind": "test",
      "argv": [
        "./gradlew",
        "--console=plain",
        "test",
        "--rerun",
        "koverXmlReport"
      ],
      "required": true,
      "tool": "gradle",
      "signal_regex": "FAILED|BUILD FAILED|AssertionFailedError|Exception in thread|Task '[A-Za-z]+' not found"
    },
    {
      "name": "test-repeat",
      "kind": "test",
      "argv": [
        "./gradlew",
        "--console=plain",
        "test",
        "--rerun"
      ],
      "required": true,
      "tool": "gradle",
      "repeat": 2,
      "signal_regex": "FAILED|BUILD FAILED|AssertionFailedError|Exception in thread"
    },
    {
      "name": "coverage",
      "kind": "coverage",
      "internal": "coverage",
      "required": true,
      "skippable": false
    },
    {
      "name": "osv",
      "kind": "vuln",
      "argv": [
        "osv-scanner",
        "scan",
        "source",
        "-L",
        "gradle.lockfile"
      ],
      "required": false,
      "tool": "osv-scanner",
      "default": "off",
      "when_file": [
        "gradle.lockfile"
      ],
      "install": "go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest"
    }
  ],
  "security": {"checks": ["osv"]},
  "test_commands": [
    {
      "argv_prefix": [
        "./gradlew",
        "test"
      ]
    },
    {
      "argv_prefix": [
        "./gradlew",
        "check"
      ]
    },
    {
      "argv_prefix": [
        "./gradlew",
        "integrationTest"
      ]
    },
    {
      "argv_prefix": [
        "./gradlew",
        "koverXmlReport"
      ]
    },
    {
      "argv_prefix": [
        "gradle",
        "test"
      ]
    },
    {
      "argv_prefix": [
        "gradle",
        "check"
      ]
    }
  ],
  "race": {
    "mode": "none",
    "checks": [
      "test",
      "test-repeat"
    ],
    "reason": "The JVM has no general data race detector (no TSan on HotSpot); Lincheck checks linearizability and jcstress checks JMM litmus tests, neither is a drop-in flag",
    "substitute": "JUnit parallel execution and random method order set in junit-platform.properties (junit.jupiter.execution.parallel.enabled=true, junit.jupiter.execution.parallel.mode.default=concurrent, junit.jupiter.testmethod.order.default=org.junit.jupiter.api.MethodOrderer$Random; Gradle -D does not reach the test JVM), run twice more by test-repeat (a new random seed each run), plus Lincheck for concurrent structures and runTest virtual time for coroutines"
  },
  "coverage": {
    "format": "jacoco",
    "path": "build/reports/kover/report.xml",
    "produced_by": [
      "test"
    ],
    "granularity": "line",
    "exclude": [
      "**/build/**"
    ],
    "source_roots": [
      "src/main/kotlin"
    ]
  },
  "post_edit": null,
  "cache_env": {},
  "shared_env": [
    "GRADLE_USER_HOME",
    "GRADLE_RO_DEP_CACHE"
  ],
  "cache_argv": {
    "./gradlew": [
      "--project-cache-dir",
      "{run}/.gradle"
    ]
  },
  "artifacts": [
    "build/",
    ".gradle/",
    ".kotlin/",
    "out/",
    "*.class",
    "hs_err_pid*.log",
    "*.hprof",
    "*.jfr",
    "*.ic",
    "*.exec",
    "**/build/"
  ],
  "arch": {
    "parser": "regex",
    "import_regex": "^\\s*import\\s+([A-Za-z0-9_.]+)(?:\\.\\*)?(?:\\s+as\\s+\\w+)?\\s*$",
    "resolver": "package-dir",
    "forbidden_in_domain": [
      "java.sql",
      "java.net",
      "java.io",
      "javax.persistence",
      "jakarta.persistence",
      "org.springframework",
      "io.ktor",
      "com.fasterxml.jackson"
    ],
    "impure_calls": [
      "Instant.now",
      "LocalDateTime.now",
      "LocalDate.now",
      "System.currentTimeMillis",
      "UUID.randomUUID",
      "Random.",
      "GlobalScope",
      "Thread."
    ]
  },
  "test_jobs": "--max-workers=2",
  "config_files": [
    ".editorconfig",
    "config/detekt/detekt.yml",
    "detekt.yml",
    "gradle/libs.versions.toml",
    "gradle.properties",
    "settings.gradle.kts",
    "build.gradle.kts",
    "gradle.lockfile",
    "src/test/resources/junit-platform.properties"
  ],
  "sources": {
    "checks": "https://docs.gradle.org/current/userguide/command_line_interface.html",
    "race": "https://github.com/JetBrains/lincheck",
    "junit": "https://docs.junit.org/current/writing-tests/test-execution-order.html",
    "coverage": "https://kotlin.github.io/kotlinx-kover/gradle-plugin/",
    "detekt": "https://detekt.dev/docs/intro",
    "ktlint": "https://ktlint.github.io/ktlint/latest/",
    "locking": "https://docs.gradle.org/current/userguide/dependency_locking.html",
    "cache": "https://docs.gradle.org/current/userguide/build_environment.html",
    "osv": "https://google.github.io/osv-scanner/"
  },
  "notes": [
    "Prerequisites the architect or kotlin-engineer adds in wave 0 (D13, logged with loops run override): the Kover plugin org.jetbrains.kotlinx.kover 0.9.11 (applied in the root project, aggregating modules); src/test/resources/junit-platform.properties with the three race keys; useJUnitPlatform() in tasks.test; allWarningsAsErrors = true; dependency locking with a committed gradle.lockfile.",
    "ktlint and detekt are skipped with an install hint when their Gradle plugin is missing. detekt 2.x (dev.detekt) is alpha; the task name is still detekt.",
    "arch: the importing file's package is read from its package header, not its directory (Kotlin does not enforce the layout)."
  ]
}
