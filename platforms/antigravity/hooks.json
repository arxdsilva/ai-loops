{
  "loops": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook post-edit --platform antigravity",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook trace --platform antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook read-guard --platform antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook test-guard --platform antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook toolchain-env --platform antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook model-guard --platform antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/loops hook write-guard --platform antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "./bin/loops hook session-start --platform antigravity",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./bin/loops hook stop-gate --platform antigravity",
        "timeout": 10
      }
    ],
    "enabled": true
  }
}
