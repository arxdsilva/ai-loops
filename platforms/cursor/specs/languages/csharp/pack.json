{
  "schema": 1,
  "id": "csharp",
  "name": "C# (.NET)",
  "versions": {
    "stable": "10.0",
    "lts": "10.0",
    "as_of": "2026-11"
  },
  "detect": [
    {
      "file": "global.json"
    },
    {
      "glob": "*.slnx"
    },
    {
      "glob": "*.sln"
    },
    {
      "glob": "*.csproj"
    },
    {
      "file": "Directory.Build.props"
    }
  ],
  "variants": [
    {
      "name": "mtp",
      "detect": [
        {
          "file": "global.json",
          "contains": "Microsoft.Testing.Platform"
        }
      ],
      "checks": [
        {
          "name": "test",
          "argv": [
            "dotnet",
            "test",
            "--no-build",
            "-c",
            "Release",
            "--minimum-expected-tests",
            "1",
            "{coverage_args}"
          ],
          "coverage_args": [
            "--results-directory",
            "{coverage_dir}",
            "--",
            "--coverage",
            "--coverage-output-format",
            "cobertura"
          ],
          "note": "Microsoft.Testing.Platform runner (global.json test.runner). Do not pass --coverage-output: each test project writes <guid>.cobertura.xml under the results directory, so projects cannot overwrite each other."
        },
        {
          "name": "concurrency-repeat",
          "argv": [
            "dotnet",
            "test",
            "--no-build",
            "-c",
            "Release",
            "--ignore-exit-code",
            "8",
            "--",
            "--filter-trait",
            "Category=Concurrency"
          ],
          "note": "xunit.v3 MTP trait filter; exit 8 (zero tests matched) is ignored so a project without Concurrency tests passes"
        }
      ]
    }
  ],
  "source_globs": [
    "**/*.cs"
  ],
  "test_globs": [
    "**/*Tests.cs",
    "**/*Test.cs",
    "tests/**/*.cs",
    "**/*.Tests/**/*.cs",
    "**/*.IntegrationTests/**/*.cs"
  ],
  "generated": {
    "globs": [
      "**/*.g.cs",
      "**/*.g.i.cs",
      "**/*.Designer.cs",
      "**/*.generated.cs",
      "**/obj/**",
      "**/Migrations/*.cs"
    ],
    "header_regex": "^//\\s*<auto-generated"
  },
  "env": {
    "MSBUILDDISABLENODEREUSE": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "checks": [
    {
      "name": "restore",
      "kind": "deps",
      "argv": [
        "dotnet",
        "restore",
        "--locked-mode"
      ],
      "required": false,
      "tool": "dotnet",
      "when_file": [
        "**/packages.lock.json"
      ],
      "note": "frozen restore, only when packages.lock.json is committed (CS-REPO-07); build restores implicitly otherwise"
    },
    {
      "name": "build",
      "kind": "build",
      "argv": [
        "dotnet",
        "build",
        "-warnaserror",
        "-c",
        "Release"
      ],
      "required": true,
      "tool": "dotnet",
      "note": "also runs the Roslyn analyzers and nullable checks as errors (CS-TOOL-03, CS-TOOL-05)"
    },
    {
      "name": "format",
      "kind": "format",
      "argv": [
        "dotnet",
        "format",
        "--verify-no-changes",
        "--no-restore"
      ],
      "required": true,
      "tool": "dotnet",
      "when_file": [
        ".editorconfig"
      ],
      "fails_on": "exit"
    },
    {
      "name": "arch",
      "kind": "arch",
      "internal": "arch",
      "required": false
    },
    {
      "name": "test",
      "kind": "test",
      "required": true,
      "tool": "dotnet",
      "argv": [
        "dotnet",
        "test",
        "--no-build",
        "-c",
        "Release",
        "{coverage_args}"
      ],
      "coverage_args": [
        "--collect:XPlat Code Coverage",
        "--results-directory",
        "{coverage_dir}"
      ],
      "signal_regex": "^\\s*Failed |\\[FAIL\\]|Error Message:|Assert\\.|error (CS|MSB)\\d+"
    },
    {
      "name": "concurrency-repeat",
      "kind": "test",
      "required": true,
      "tool": "dotnet",
      "repeat": 3,
      "argv": [
        "dotnet",
        "test",
        "--no-build",
        "-c",
        "Release",
        "--filter",
        "Category=Concurrency"
      ],
      "signal_regex": "^\\s*Failed |\\[FAIL\\]|Error Message:|Assert\\.",
      "note": "race substitute: tests tagged [Trait(\"Category\",\"Concurrency\")] run 3 times with xUnit parallel collections on; zero matching tests passes"
    },
    {
      "name": "coverage",
      "kind": "coverage",
      "internal": "coverage",
      "required": true,
      "skippable": false
    },
    {
      "name": "vuln",
      "kind": "vuln",
      "argv": [
        "dotnet",
        "package",
        "list",
        "--vulnerable",
        "--include-transitive",
        "--format",
        "json"
      ],
      "required": false,
      "tool": "dotnet",
      "default": "off",
      "fail_regex": "\"vulnerabilities\"\\s*:\\s*\\[\\s*\\{",
      "note": "the command exits 0 even when it finds vulnerabilities, so the JSON is matched across newlines; SDK 9 and older: dotnet list package --vulnerable --include-transitive"
    }
  ],
  "test_commands": [
    {
      "argv_prefix": [
        "dotnet",
        "test"
      ]
    },
    {
      "argv_prefix": [
        "dotnet",
        "vstest"
      ]
    }
  ],
  "race": {
    "mode": "none",
    "checks": [
      "build",
      "test",
      "concurrency-repeat"
    ],
    "reason": "no managed race detector exists for .NET; ThreadSanitizer does not instrument managed code",
    "substitute": "xUnit parallel collections stay on (test), tests tagged Category=Concurrency run 3 times (concurrency-repeat), and the concurrency analyzers CA2007/CA2012/CA2016 and VSTHRD are errors in the build; optional Microsoft Coyote"
  },
  "coverage": {
    "format": "cobertura",
    "path": "{coverage_dir}/**/*cobertura.xml",
    "produced_by": [
      "test"
    ],
    "granularity": "line+branch",
    "exclude": [
      "**/Migrations/**",
      "**/obj/**",
      "**/bin/**",
      "**/Program.cs",
      "tests/**",
      "benchmarks/**",
      "**/*.Tests/**"
    ]
  },
  "post_edit": {
    "format_file": [
      "dotnet",
      "format",
      "--no-restore",
      "--include",
      "{file}"
    ],
    "lint_dir": null
  },
  "cache_env": {
    "DOTNET_CLI_HOME": "cache",
    "TMPDIR": "tmp"
  },
  "shared_env": [
    "NUGET_PACKAGES",
    "NUGET_HTTP_CACHE_PATH",
    "NUGET_PLUGINS_CACHE_PATH"
  ],
  "artifacts": [
    "bin/",
    "obj/",
    "TestResults/",
    "*.cobertura.xml",
    "*.coverage",
    "*.trx",
    "*.binlog",
    "BenchmarkDotNet.Artifacts/",
    ".vs/",
    "artifacts/",
    "publish/",
    "*.nupkg",
    "*.snupkg",
    "mono_crash.*.json",
    "**/bin/",
    "**/obj/"
  ],
  "arch": {
    "parser": "regex",
    "import_regex": "^\\s*(?:global\\s+)?using\\s+(?:static\\s+)?(?:[A-Za-z_]\\w*\\s*=\\s*)?([A-Za-z_][\\w.]*)\\s*;",
    "resolver": "project-reference",
    "forbidden_in_domain": [
      "System.IO",
      "System.Net.Http",
      "System.Data",
      "Microsoft.EntityFrameworkCore",
      "Microsoft.AspNetCore",
      "Microsoft.Extensions.Logging",
      "System.Diagnostics.Process"
    ],
    "impure_calls": [
      "DateTime.Now",
      "DateTime.UtcNow",
      "DateTimeOffset.Now",
      "DateTimeOffset.UtcNow",
      "Guid.NewGuid",
      "Random.Shared",
      "new Random(",
      "Environment.GetEnvironmentVariable",
      "Task.Run",
      "Thread.Sleep"
    ]
  },
  "test_jobs": "-maxcpucount:2",
  "config_files": [
    "global.json",
    "Directory.Build.props",
    "Directory.Build.targets",
    "Directory.Packages.props",
    "nuget.config",
    ".editorconfig",
    "stylecop.json",
    "xunit.runner.json",
    "testconfig.json",
    "coverlet.runsettings",
    ".runsettings",
    "dotnet-tools.json"
  ],
  "sources": {
    "checks": "https://learn.microsoft.com/en-us/dotnet/core/tools/dotnet-test-mtp",
    "build": "https://learn.microsoft.com/en-us/dotnet/core/tools/dotnet-build",
    "format": "https://learn.microsoft.com/en-us/dotnet/core/tools/dotnet-format",
    "vuln": "https://learn.microsoft.com/en-us/dotnet/core/tools/dotnet-package-list",
    "restore_locked": "https://learn.microsoft.com/en-us/nuget/consume-packages/package-references-in-project-files",
    "coverage_vstest": "https://learn.microsoft.com/en-us/dotnet/core/testing/unit-testing-code-coverage",
    "coverage_mtp": "https://learn.microsoft.com/en-us/dotnet/core/testing/microsoft-testing-platform-code-coverage",
    "global_json": "https://learn.microsoft.com/en-us/dotnet/core/tools/global-json",
    "race": "https://xunit.net/docs/running-tests-in-parallel",
    "support": "https://dotnet.microsoft.com/en-us/platform/support/policy/dotnet-core"
  },
  "notes": [
    "Project rules win: follow the repo's own .editorconfig, analyzer severities, runsettings and test framework over these defaults, and log each override with loops run override.",
    "Under Microsoft.Testing.Platform (global.json test.runner) the mtp variant applies; --collect:XPlat Code Coverage fails there. Detect the runner, never choose it."
  ]
}
