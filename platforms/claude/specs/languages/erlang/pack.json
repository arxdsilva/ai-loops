{
  "schema": 1,
  "id": "erlang",
  "name": "Erlang (OTP, rebar3)",
  "versions": {
    "stable": "29.1",
    "as_of": "2026-11"
  },
  "detect": [
    {
      "file": "rebar.config"
    },
    {
      "file": "rebar.lock"
    },
    {
      "file": "erlang.mk"
    }
  ],
  "source_globs": [
    "**/src/*.erl",
    "**/include/*.hrl",
    "**/src/*.app.src"
  ],
  "test_globs": [
    "**/test/*_SUITE.erl",
    "**/test/*_tests.erl",
    "**/src/*_tests.erl",
    "**/test/prop_*.erl"
  ],
  "generated": {
    "globs": [
      "**/_build/**",
      "**/*_pb.erl",
      "**/*_pb.hrl",
      "**/*_gen.erl",
      "**/*.yrl.erl"
    ],
    "header_regex": "^%% (Generated|Autogenerated|This file is generated).*$"
  },
  "checks": [
    {
      "name": "compile",
      "kind": "build",
      "argv": [
        "rebar3",
        "compile"
      ],
      "required": true,
      "tool": "rebar3"
    },
    {
      "name": "fmt",
      "kind": "format",
      "argv": [
        "rebar3",
        "fmt",
        "--check"
      ],
      "required": false,
      "tool": "erlfmt",
      "install": "add {project_plugins, [erlfmt]}. to rebar.config",
      "skip_on": {
        "output_regex": "Command fmt not found",
        "note": "erlfmt plugin not configured: add {project_plugins, [erlfmt]}. to rebar.config"
      }
    },
    {
      "name": "xref",
      "kind": "arch",
      "argv": [
        "rebar3",
        "xref"
      ],
      "required": true,
      "tool": "rebar3"
    },
    {
      "name": "elvis",
      "kind": "lint",
      "argv": [
        "rebar3",
        "lint"
      ],
      "required": false,
      "tool": "elvis",
      "when_file": [
        "elvis.config"
      ],
      "install": "add {project_plugins, [rebar3_lint]}. to rebar.config and commit an elvis.config (rebar3 lint exits 1 without one)"
    },
    {
      "name": "dialyzer",
      "kind": "typecheck",
      "argv": [
        "rebar3",
        "dialyzer"
      ],
      "required": true,
      "tool": "dialyzer"
    },
    {
      "name": "eunit",
      "kind": "test",
      "argv": [
        "rebar3",
        "eunit",
        "--cover"
      ],
      "required": true,
      "tool": "rebar3"
    },
    {
      "name": "ct",
      "kind": "test",
      "argv": [
        "rebar3",
        "ct",
        "--cover"
      ],
      "required": true,
      "tool": "rebar3"
    },
    {
      "name": "proper",
      "kind": "test",
      "argv": [
        "rebar3",
        "proper",
        "-n",
        "100",
        "--cover"
      ],
      "required": false,
      "tool": "rebar3_proper",
      "install": "add {project_plugins, [rebar3_proper]}. to rebar.config and a proper dep in the test profile",
      "skip_on": {
        "output_regex": "Command proper not found",
        "note": "rebar3_proper plugin not configured: add {project_plugins, [rebar3_proper]}. to rebar.config"
      }
    },
    {
      "name": "coverage",
      "kind": "coverage",
      "internal": "coverage",
      "required": true,
      "skippable": false
    },
    {
      "name": "audit",
      "kind": "vuln",
      "argv": [
        "rebar3",
        "audit"
      ],
      "required": false,
      "tool": "rebar3_audit",
      "default": "off",
      "install": "add {project_plugins, [rebar3_audit]}. to rebar.config (needs network access to api.github.com)"
    },
    {
      "name": "sbom",
      "kind": "sbom",
      "argv": [
        "rebar3",
        "sbom"
      ],
      "required": false,
      "tool": "rebar3_sbom",
      "default": "off",
      "install": "add {project_plugins, [rebar3_sbom]}. to rebar.config"
    }
  ],
  "security": {"checks": ["audit"]},
  "test_commands": [
    {
      "argv_prefix": [
        "rebar3",
        "eunit"
      ]
    },
    {
      "argv_prefix": [
        "rebar3",
        "ct"
      ]
    },
    {
      "argv_prefix": [
        "rebar3",
        "proper"
      ]
    }
  ],
  "race": {
    "mode": "none",
    "checks": [
      "eunit",
      "ct"
    ],
    "variants": [
      {
        "ERL_FLAGS": "+S 1:1"
      },
      {
        "ERL_FLAGS": "+S 8:8"
      }
    ],
    "reason": "BEAM processes share nothing, so there is no data-race sanitizer or flag; ETS, message-order and timing races remain",
    "substitute": "eunit and ct run once per variant (ERL_FLAGS='+S 1:1' then '+S 8:8', which changes scheduling), plus rebar3 ct --repeat while iterating and a proper_statem test for every gen_statem, ETS-backed or multi-process module (ERL-CONC-04)"
  },
  "coverage": {
    "format": "cobertura",
    "path": "_build/test/covertool/*.covertool.xml",
    "produced_by": [
      "eunit",
      "ct"
    ],
    "produce": [
      {
        "argv": [
          "rebar3",
          "covertool",
          "generate"
        ]
      }
    ],
    "granularity": "line",
    "exclude": [
      "**/_build/**"
    ],
    "source_roots": [
      "src",
      "apps",
      "lib"
    ]
  },
  "post_edit": {
    "format_file": [
      "rebar3",
      "fmt",
      "-w",
      "{file}"
    ]
  },
  "cache_env": {
    "ERL_CRASH_DUMP": "{tmp}/erl_crash.dump"
  },
  "shared_env": [
    "REBAR_CACHE_DIR",
    "REBAR_GLOBAL_CONFIG_DIR"
  ],
  "artifacts": [
    "_build/",
    "ct_logs/",
    "*.beam",
    "erl_crash.dump",
    "rebar3.crashdump",
    "*.coverdata",
    "bom.xml",
    "bom.json",
    "Mnesia.*/",
    ".rebar3/",
    "*.plt"
  ],
  "arch": {
    "parser": "none",
    "native_check": "xref",
    "forbidden_in_domain": [
      "gen_server",
      "gen_statem",
      "gen_event",
      "supervisor",
      "ets",
      "dets",
      "mnesia",
      "file",
      "gen_tcp",
      "gen_udp",
      "httpc",
      "ssl",
      "os",
      "application",
      "persistent_term",
      "logger"
    ],
    "impure_calls": [
      "os:timestamp",
      "erlang:system_time",
      "erlang:monotonic_time",
      "erlang:now",
      "rand:",
      "crypto:strong_rand_bytes",
      "erlang:send",
      "spawn"
    ]
  },
  "config_files": [
    "rebar.config",
    "rebar.config.script",
    "elvis.config",
    ".editorconfig",
    ".tool-versions",
    "rebar.lock",
    "config/sys.config.src",
    "config/vm.args.src",
    "Makefile",
    "erlang.mk"
  ],
  "sources": {
    "checks": "https://rebar3.org/docs/commands/",
    "race": "https://www.erlang.org/doc/system/ref_man_processes.html",
    "coverage": "https://github.com/covertool/covertool",
    "format": "https://github.com/WhatsApp/erlfmt",
    "lint": "https://github.com/inaka/rebar3_lint",
    "proper": "https://github.com/ferd/rebar3_proper",
    "sbom": "https://github.com/erlef/rebar3_sbom",
    "audit": "https://hex.pm/packages/rebar3_audit",
    "cache": "https://rebar3.org/docs/configuration/configuration/",
    "versions": "https://www.erlang.org/downloads"
  },
  "notes": [
    "Prerequisites the architect or erlang-engineer adds in wave 0 (D13, logged with loops run override): {cover_enabled, true}. and {cover_export_enabled, true}. in rebar.config, {project_plugins, [covertool]}. with {covertool, [{coverdata_files, [\"eunit.coverdata\", \"ct.coverdata\"]}]}., and {erl_opts, [debug_info, warnings_as_errors]}.",
    "coverage.produce runs rebar3 covertool generate after eunit and ct; it writes one Cobertura file per OTP app (and the umbrella root) under _build/test/covertool, and loops merges the glob.",
    "ERL_FLAGS reaches the BEAM that rebar3 starts, so race.variants runs each race check once per +S setting. Concuerror is dropped (D21): its last Hex release is 2020.",
    "elvis runs only when elvis.config exists; rebar3 lint exits 1 without one. REBAR_CACHE_DIR also holds project plugins and the global Dialyzer PLT, so it stays shared.",
    "arch: no parser (module:function( regex gives false positives on atoms and maps); rebar3 xref catches undefined and deprecated calls but does NOT enforce layer direction by itself (verified end to end): add project xref_queries for forbidden app-to-app calls, or review it (ERL-ARCH-01/02). Test commands are narrow: rebar3 do would match any build command, so it is not listed."
  ]
}
