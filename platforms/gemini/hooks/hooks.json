{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook stop-gate --platform gemini",
            "name": "stop-gate",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook post-edit --platform gemini",
            "name": "post-edit",
            "timeout": 60000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook trace --platform gemini",
            "name": "trace",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook read-guard --platform gemini",
            "name": "read-guard",
            "timeout": 10000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook test-guard --platform gemini",
            "name": "test-guard",
            "timeout": 10000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook toolchain-env --platform gemini",
            "name": "toolchain-env",
            "timeout": 10000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook model-guard --platform gemini",
            "name": "model-guard",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${extensionPath}/bin/loops\" hook session-start --platform gemini",
            "name": "session-start",
            "timeout": 120000,
            "type": "command"
          }
        ]
      }
    ]
  }
}
