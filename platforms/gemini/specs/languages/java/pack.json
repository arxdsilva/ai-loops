{
  "schema": 1,
  "id": "java",
  "name": "Java",
  "versions": {
    "stable": "27",
    "lts": "25",
    "as_of": "2026-11"
  },
  "detect": [
    {
      "file": "pom.xml"
    },
    {
      "file": "build.gradle.kts"
    },
    {
      "file": "build.gradle"
    }
  ],
  "detect_not": [
    {
      "file": "src/main/kotlin"
    }
  ],
  "variants": [
    {
      "name": "gradle",
      "detect": [
        {
          "glob": "build.gradle*"
        }
      ],
      "checks": [
        {
          "name": "build",
          "kind": "build",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "assemble"
          ],
          "required": true,
          "tool": "gradle",
          "when_file": [
            "gradlew"
          ],
          "fallback_argv": [
            "gradle",
            "--no-daemon",
            "assemble"
          ]
        },
        {
          "name": "spotless",
          "kind": "format",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "spotlessCheck"
          ],
          "required": false,
          "tool": "spotless",
          "when_file": [
            "gradlew"
          ],
          "fallback_argv": [
            "gradle",
            "--no-daemon",
            "spotlessCheck"
          ],
          "skip_on": {
            "output_regex": "Task '[^']*' not found",
            "note": "Spotless Gradle plugin not applied; add it or ignore"
          }
        },
        {
          "name": "checkstyle",
          "kind": "lint",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "checkstyleMain",
            "checkstyleTest"
          ],
          "required": false,
          "tool": "checkstyle",
          "when_file": [
            "config/checkstyle/checkstyle.xml",
            "checkstyle.xml"
          ]
        },
        {
          "name": "pmd",
          "kind": "lint",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "pmdMain"
          ],
          "required": false,
          "tool": "pmd",
          "when_file": [
            "config/pmd/ruleset.xml",
            "pmd-ruleset.xml"
          ]
        },
        {
          "name": "spotbugs",
          "kind": "lint",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "spotbugsMain"
          ],
          "required": false,
          "tool": "spotbugs",
          "when_file": [
            "gradlew"
          ],
          "fallback_argv": [
            "gradle",
            "--no-daemon",
            "spotbugsMain"
          ],
          "skip_on": {
            "output_regex": "Task '[^']*' not found",
            "note": "SpotBugs Gradle plugin not applied; add it or ignore"
          }
        },
        {
          "name": "test",
          "kind": "test",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "test",
            "--rerun",
            "jacocoTestReport"
          ],
          "required": true,
          "tool": "gradle",
          "repeat": 2,
          "when_file": [
            "gradlew"
          ],
          "fallback_argv": [
            "gradle",
            "--no-daemon",
            "test",
            "--rerun",
            "jacocoTestReport"
          ],
          "signal_regex": "FAILED|BUILD FAILED|AssertionFailedError"
        },
        {
          "name": "dependency-check",
          "kind": "vuln",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "dependencyCheckAnalyze"
          ],
          "required": false,
          "tool": "dependency-check",
          "default": "off",
          "note": "needs an NVD API key; slow on a cold database"
        },
        {
          "name": "sbom",
          "kind": "sbom",
          "argv": [
            "./gradlew",
            "--no-daemon",
            "cyclonedxBom"
          ],
          "required": false,
          "tool": "cyclonedx",
          "default": "off"
        }
      ],
      "test_commands": [
        {
          "argv_prefix": [
            "./gradlew",
            "test"
          ]
        },
        {
          "argv_prefix": [
            "gradle",
            "test"
          ]
        }
      ],
      "coverage": {
        "path": "**/build/reports/jacoco/test/jacocoTestReport.xml"
      },
      "cache_argv": {
        "./gradlew": [
          "--project-cache-dir",
          "{run}/.gradle"
        ],
        "gradle": [
          "--project-cache-dir",
          "{run}/.gradle"
        ]
      }
    }
  ],
  "scope": {},
  "source_globs": [
    "**/src/main/java/**/*.java"
  ],
  "test_globs": [
    "**/src/test/java/**/*.java",
    "**/src/integrationTest/java/**/*.java",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*IT.java"
  ],
  "generated": {
    "globs": [
      "**/target/generated-sources/**",
      "**/build/generated/**",
      "**/generated/**",
      "**/*MapperImpl.java",
      "**/*_.java"
    ],
    "header_regex": "^\\s*(?:/\\*|//)\\s*.*(?:@generated|Generated by|DO NOT EDIT).*$"
  },
  "manifest": "pom.xml",
  "checks": [
    {
      "name": "build",
      "kind": "build",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "-DskipTests",
        "verify"
      ],
      "required": true,
      "tool": "maven",
      "when_file": [
        "mvnw"
      ],
      "fallback_argv": [
        "mvn",
        "-B",
        "-ntp",
        "-DskipTests",
        "verify"
      ]
    },
    {
      "name": "spotless",
      "kind": "format",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "spotless:check"
      ],
      "when_file": [
        "mvnw"
      ],
      "fallback_argv": [
        "mvn",
        "-B",
        "-ntp",
        "spotless:check"
      ],
      "required": false,
      "tool": "spotless",
      "skip_on": {
        "output_regex": "No plugin found for prefix|Task '[^']*' not found",
        "note": "Spotless plugin is not declared in the build (pom or Gradle); add it or ignore"
      }
    },
    {
      "name": "checkstyle",
      "kind": "lint",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "checkstyle:check"
      ],
      "required": false,
      "tool": "checkstyle",
      "when_file": [
        "checkstyle.xml",
        "config/checkstyle/checkstyle.xml"
      ]
    },
    {
      "name": "pmd",
      "kind": "lint",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "pmd:check"
      ],
      "required": false,
      "tool": "pmd",
      "when_file": [
        "pmd-ruleset.xml",
        "config/pmd/ruleset.xml"
      ]
    },
    {
      "name": "spotbugs",
      "kind": "lint",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "spotbugs:check"
      ],
      "when_file": [
        "mvnw"
      ],
      "fallback_argv": [
        "mvn",
        "-B",
        "-ntp",
        "spotbugs:check"
      ],
      "required": false,
      "tool": "spotbugs",
      "skip_on": {
        "output_regex": "No plugin found for prefix|Task '[^']*' not found",
        "note": "SpotBugs plugin (with FindSecBugs) is not declared in the build (pom or Gradle); add it or ignore"
      }
    },
    {
      "name": "arch",
      "kind": "arch",
      "internal": "arch",
      "required": false
    },
    {
      "name": "test",
      "kind": "test",
      "required": true,
      "tool": "maven",
      "repeat": 2,
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "verify",
        "-Djunit.jupiter.execution.parallel.enabled=true",
        "-Djunit.jupiter.execution.parallel.mode.default=concurrent",
        "-Djunit.jupiter.execution.parallel.mode.classes.default=concurrent",
        "-Djunit.jupiter.testmethod.order.default=org.junit.jupiter.api.MethodOrderer$Random",
        "-Djunit.jupiter.execution.order.random.seed={seed}"
      ],
      "when_file": [
        "mvnw"
      ],
      "fallback_argv": [
        "mvn",
        "-B",
        "-ntp",
        "verify",
        "-Djunit.jupiter.execution.parallel.enabled=true",
        "-Djunit.jupiter.execution.parallel.mode.default=concurrent",
        "-Djunit.jupiter.execution.parallel.mode.classes.default=concurrent",
        "-Djunit.jupiter.testmethod.order.default=org.junit.jupiter.api.MethodOrderer$Random",
        "-Djunit.jupiter.execution.order.random.seed={seed}"
      ],
      "signal_regex": "\\[ERROR\\]|FAILURE!|Failures: [1-9]|Errors: [1-9]"
    },
    {
      "name": "coverage",
      "kind": "coverage",
      "internal": "coverage",
      "required": true,
      "skippable": false
    },
    {
      "name": "osv-scanner",
      "kind": "vuln",
      "argv": [
        "osv-scanner",
        "scan",
        "source",
        "-r",
        "."
      ],
      "required": false,
      "tool": "osv-scanner",
      "default": "off",
      "install": "go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest"
    },
    {
      "name": "dependency-check",
      "kind": "vuln",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "org.owasp:dependency-check-maven:check",
        "-DfailBuildOnCVSS=7"
      ],
      "required": false,
      "tool": "dependency-check",
      "default": "off",
      "note": "needs an NVD API key; slow on a cold database"
    },
    {
      "name": "sbom",
      "kind": "sbom",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom"
      ],
      "required": false,
      "tool": "cyclonedx",
      "default": "off"
    }
  ],
  "security": {"checks": ["osv-scanner", "dependency-check"]},
  "test_commands": [
    {
      "argv_prefix": [
        "./mvnw",
        "test"
      ]
    },
    {
      "argv_prefix": [
        "./mvnw",
        "verify"
      ]
    },
    {
      "argv_prefix": [
        "mvn",
        "test"
      ]
    },
    {
      "argv_prefix": [
        "mvn",
        "verify"
      ]
    },
    {
      "argv_prefix": [
        "./gradlew",
        "test"
      ]
    },
    {
      "argv_prefix": [
        "gradle",
        "test"
      ]
    }
  ],
  "race": {
    "mode": "none",
    "checks": [
      "test"
    ],
    "reason": "The JVM has no general data-race detector. jcstress and Lincheck target specific lock-free code and are not a drop-in flag on the normal test command.",
    "substitute": "The test check runs the suite twice with JUnit Jupiter parallel execution and random method order (a different junit.jupiter.execution.order.random.seed each run, recorded by the gate). Gradle reads the junit.jupiter.* keys from a committed junit-platform.properties, since CLI -D does not reach the test JVM. Run jcstress or Lincheck suites too if the project has them."
  },
  "coverage": {
    "format": "jacoco",
    "path": "**/target/site/jacoco/jacoco.xml",
    "produced_by": [
      "test"
    ],
    "granularity": "line",
    "source_roots": [
      "src/main/java"
    ],
    "exclude": [
      "**/*Application.java",
      "**/bootstrap/**",
      "**/config/**"
    ]
  },
  "post_edit": null,
  "cache_env": {
    "JAVA_TOOL_OPTIONS": "-Djava.io.tmpdir={tmp}",
    "MAVEN_ARGS": "-Djacoco.destFile={run}/jacoco.exec -Djacoco.dataFile={run}/jacoco.exec"
  },
  "shared_env": [
    "GRADLE_USER_HOME",
    "MAVEN_USER_HOME"
  ],
  "artifacts": [
    "target/",
    "build/",
    ".gradle/",
    "out/",
    "*.class",
    "hs_err_pid*.log",
    "replay_pid*.log",
    "*.hprof",
    "*.jfr",
    "jacoco.exec",
    "*.exec",
    ".jqwik-database",
    ".pitest/",
    "dependency-check-report.*",
    "dependency-reduced-pom.xml",
    ".flattened-pom.xml",
    "**/target/",
    "**/build/",
    ".metrics/"
  ],
  "arch": {
    "parser": "regex",
    "import_regex": "^\\s*import\\s+(?:static\\s+)?([A-Za-z_][\\w.]*)(?:\\.\\*)?\\s*;",
    "resolver": "package-dir",
    "forbidden_in_domain": [
      "org.springframework",
      "jakarta.persistence",
      "javax.persistence",
      "jakarta.validation",
      "com.fasterxml.jackson",
      "java.sql",
      "java.net.http",
      "java.io",
      "java.nio.file"
    ],
    "impure_calls": [
      "System.currentTimeMillis",
      "Instant.now",
      "LocalDate.now",
      "LocalDateTime.now",
      "ZonedDateTime.now",
      "UUID.randomUUID",
      "new Random",
      "Math.random",
      "new Thread",
      "Executors."
    ]
  },
  "test_jobs": "-T 2 (Maven: parallel modules, not Surefire forks) / --max-workers=2 (Gradle)",
  "config_files": [
    ".editorconfig",
    "checkstyle.xml",
    "config/checkstyle/checkstyle.xml",
    "pmd-ruleset.xml",
    "config/pmd/ruleset.xml",
    "spotbugs-exclude.xml",
    "config/spotbugs/exclude.xml",
    ".mvn/maven.config",
    ".mvn/jvm.config",
    "pom.xml",
    "build.gradle.kts",
    "build.gradle",
    "gradle.properties",
    "gradle/libs.versions.toml",
    "src/test/resources/junit-platform.properties"
  ],
  "sources": {
    "checks": "https://maven.apache.org/guides/introduction/introduction-to-the-lifecycle.html",
    "spotless": "https://github.com/diffplug/spotless/tree/main/plugin-maven",
    "spotbugs": "https://spotbugs.github.io/spotbugs-maven-plugin/",
    "pmd": "https://maven.apache.org/plugins/maven-pmd-plugin/",
    "checkstyle": "https://maven.apache.org/plugins/maven-checkstyle-plugin/",
    "osv": "https://google.github.io/osv-scanner/usage/",
    "dependency_check": "https://jeremylong.github.io/DependencyCheck/dependency-check-maven/",
    "cyclonedx": "https://github.com/cyclonedx/cyclonedx-maven-plugin",
    "race": "https://docs.junit.org/current/writing-tests/parallel-execution.html",
    "method_order": "https://docs.junit.org/current/writing-tests/test-execution-order.html",
    "coverage": "https://www.jacoco.org/jacoco/trunk/doc/maven.html",
    "coverage_gradle": "https://docs.gradle.org/current/userguide/jacoco_plugin.html",
    "caches": "https://docs.gradle.org/current/userguide/build_environment.html"
  }
}
